<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      用于列出已安装的应用，供用户挑选音乐软件。
      本应用不通过应用商店分发，因此不受商店对该权限的限制。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 通知栏里的快捷开关需要它（较新系统才需要动态申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MicControl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          接收通知栏按钮的点击。不导出，只有本应用自己的通知能触发它。
        -->
        <receiver
            android:name=".ToggleReceiver"
            android:exported="false" />

        <!--
          Xposed 模块声明。xposedmodule=true 让 LSPosed 把这个应用识别为模块；
          配合 assets/xposed_init 里写的入口类名，框架才能加载 hook 代码。
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!--
          声明"本模块要跨进程读取自己的设置文件"。

          必须写这一条：hook 代码跑在别的应用进程里，要去读本应用的设置文件，
          而系统默认禁止一个应用读另一个应用的数据。声明之后，框架会为本模块的
          设置文件做特殊处理，读取才能成功。

          缺了这一条的后果不是报错，而是**静默读到默认值**——开关看起来永远
          是关的，表现为"钩子挂上了但从来不生效"，很难察觉。
        -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

    </application>

</manifest>
